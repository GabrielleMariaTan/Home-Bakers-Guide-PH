# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.
# These are read ONLY on the server (route handler + seed script); none are NEXT_PUBLIC_.

OPENAI_API_KEY=sk-...

# Upstash Vector — REST credentials from your index page in the Upstash console.
# Create the index with 1536 dimensions + COSINE (matches text-embedding-3-small).
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...
